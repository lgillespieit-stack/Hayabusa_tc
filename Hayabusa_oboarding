<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Hayabusa Training Centre | New Student Onboarding</title>

<style>
:root {
  --black: #080808;
  --panel: #151515;
  --panel2: #1d1d1d;
  --red: #d71920;
  --red-light: #ff4b52;
  --white: #ffffff;
  --muted: #c9c9c9;
  --line: #383838;
  --green: #65cf98;
}

* {
  box-sizing: border-box;
}

html {
  background: var(--black);
}

body {
  margin: 0;
  background: var(--black);
  color: var(--white);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

button,
a {
  font: inherit;
}

button {
  cursor: pointer;
}

/* ---------- HEADER ---------- */

.topbar {
  position: sticky;
  top: 0;
  z-index: 100;

  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;

  padding: 15px 20px;

  background: rgba(8,8,8,.97);
  border-bottom: 1px solid var(--line);
}

.brand {
  color: var(--white);
  font-weight: 900;
  letter-spacing: .06em;
  font-size: 14px;
}

.brand span {
  color: var(--red-light);
}

.menu-button,
.primary-button,
.secondary-button,
.store-button {
  min-height: 46px;
  padding: 11px 17px;

  border-radius: 8px;

  font-weight: 900;
  text-decoration: none;

  transition: .2s;
}

.menu-button,
.primary-button,
.store-button {
  background: var(--red);
  border: 1px solid var(--red);
  color: #fff;
}

.secondary-button {
  background: #202020;
  border: 1px solid #505050;
  color: #fff;
}

.menu-button:hover,
.primary-button:hover,
.store-button:hover {
  background: #ef2028;
}

.secondary-button:hover {
  background: #303030;
}

button:focus-visible,
a:focus-visible,
summary:focus-visible {
  outline: 3px solid white;
  outline-offset: 3px;
}

/* ---------- PROGRESS ---------- */

.progress {
  height: 5px;
  background: #242424;
}

.progress-fill {
  width: 10%;
  height: 100%;

  background: var(--red);

  transition: width .3s ease;
}

/* ---------- PAGE ---------- */

.stage {
  max-width: 1050px;
  margin: auto;

  padding: 32px 22px 40px;
}

/* ---------- SECTION MENU ---------- */

.section-menu {
  display: none;

  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 7px;

  margin-bottom: 28px;
  padding: 10px;

  background: #101010;

  border: 1px solid var(--line);
  border-radius: 10px;
}

.section-menu.open {
  display: grid;
}

.section-menu button {
  min-height: 50px;

  padding: 11px 13px;

  text-align: left;

  border: 0;
  border-radius: 7px;

  background: #1a1a1a;
  color: #fff;
}

.section-menu button:hover,
.section-menu button.current {
  background: #3b1315;
}

.section-menu b {
  color: var(--red-light);
  margin-right: 7px;
}

/* ---------- VIEWS ---------- */

.view {
  display: none;
}

.view.active {
  display: block;
  animation: fade .22s ease;
}

@keyframes fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ---------- TYPOGRAPHY ---------- */

.kicker {
  margin-bottom: 8px;

  color: var(--red-light);

  font-size: 11px;
  font-weight: 900;

  letter-spacing: .14em;
  text-transform: uppercase;
}

.title {
  margin: 0 0 16px;

  color: #fff;

  font-size: clamp(36px,7vw,58px);
  line-height: 1;

  font-weight: 900;
}

.title span {
  color: var(--red-light);
}

.lead {
  max-width: 760px;

  margin: 0 0 25px;

  color: var(--muted);

  font-size: 17px;
}

h1,
h2,
h3,
strong {
  color: #fff;
}

/* ---------- WELCOME ---------- */

.welcome {
  text-align: center;
}

.welcome-photo {
  display: block;

  width: 100%;
  max-height: 480px;

  object-fit: cover;

  margin-bottom: 30px;

  border: 1px solid var(--line);
  border-radius: 12px;
}

.welcome .lead {
  margin-left: auto;
  margin-right: auto;
}

.welcome .primary-button {
  display: inline-block;
}

/* ---------- CARDS ---------- */

.grid {
  display: grid;

  grid-template-columns: repeat(2,minmax(0,1fr));

  gap: 14px;
}

.card {
  padding: 19px;

  background: var(--panel);

  border: 1px solid var(--line);
  border-radius: 10px;

  color: #fff;
}

.card h3 {
  margin: 0 0 8px;
  color: #fff;
}

.card p {
  margin: 0;
  color: var(--muted);
}

.wide {
  grid-column: 1 / -1;
}

/* ---------- IMAGES ---------- */

.section-photo {
  display: block;

  width: 100%;
  max-height: 480px;

  object-fit: cover;

  margin: 22px 0;

  border: 1px solid var(--line);
  border-radius: 12px;
}

/* ---------- RASHGUARDS ---------- */

.rashguards {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 12px;

  margin-top: 20px;
}

.rashguard {
  overflow: hidden;

  background: #fff;

  border: 1px solid var(--line);
  border-radius: 10px;
}

.rashguard img {
  display: block;

  width: 100%;
  height: 410px;

  object-fit: contain;

  background: #fff;
}

.rashguard-label {
  padding: 11px;

  background: #151515;
  color: #fff;

  text-align: center;

  font-size: 12px;
  font-weight: 900;

  letter-spacing: .05em;
}

/* ---------- NOTICE ---------- */

.notice {
  margin-top: 18px;

  padding: 16px 18px;

  background: #1b0d0e;

  border-left: 4px solid var(--red);

  color: #eee;
}

/* ---------- STEPS ---------- */

.step {
  display: flex;

  align-items: flex-start;

  gap: 14px;
}

.number {
  flex: 0 0 32px;

  width: 32px;
  height: 32px;

  display: grid;

  place-items: center;

  border-radius: 50%;

  background: var(--red);
  color: #fff;

  font-weight: 900;
}

/* ---------- COACHES ---------- */

.coach {
  display: flex;

  align-items: center;

  gap: 15px;
}

.coach-avatar {
  flex: 0 0 62px;

  width: 62px;
  height: 62px;

  display: grid;

  place-items: center;

  background: #272727;

  border: 2px solid var(--red);
  border-radius: 50%;

  color: #fff;

  font-weight: 900;
}

/* ---------- STORE ---------- */

.store-area {
  margin-top: 25px;

  padding: 24px;

  text-align: center;

  background: #111;

  border: 1px solid var(--line);
  border-radius: 10px;
}

.store-area h3 {
  margin-top: 0;
}

.store-area p {
  color: var(--muted);
}

.store-button {
  display: inline-block;

  margin-top: 8px;

  padding-left: 25px;
  padding-right: 25px;
}

/* ---------- FAQ ---------- */

.faq {
  display: grid;

  gap: 10px;
}

.faq details {
  background: var(--panel);

  border: 1px solid var(--line);
  border-radius: 9px;

  color: #fff;
}

.faq summary {
  padding: 16px;

  list-style: none;

  cursor: pointer;

  color: #fff;

  font-weight: 900;
}

.faq summary::-webkit-details-marker {
  display: none;
}

.faq summary::after {
  content: "+";

  float: right;

  color: var(--red-light);

  font-size: 21px;
}

.faq details[open] summary::after {
  content: "−";
}

.faq-answer {
  padding: 0 16px 17px;

  color: var(--muted);
}

/* ---------- CHECKLIST ---------- */

.check {
  display: flex;

  align-items: flex-start;

  gap: 11px;

  margin: 9px 0;

  padding: 14px;

  background: var(--panel);

  border: 1px solid var(--line);
  border-radius: 8px;

  color: #fff;
}

.check input {
  width: 19px;
  height: 19px;

  margin-top: 3px;

  accent-color: var(--red);
}

.check.complete {
  background: #132019;

  border-color: #4f8060;
}

.count {
  margin-top: 13px;

  text-align: center;

  color: var(--muted);

  font-size: 13px;
}

/* ---------- BOTTOM NAV ---------- */

.bottom-nav {
  display: flex;

  justify-content: space-between;

  gap: 10px;

  flex-wrap: wrap;

  margin-top: 32px;

  padding-top: 20px;

  border-top: 1px solid var(--line);
}

/* ---------- FOOTER ---------- */

footer {
  padding: 20px;

  text-align: center;

  background: #0c0c0c;

  border-top: 1px solid var(--line);

  color: #999;

  font-size: 12px;
}

/* ---------- MOBILE ---------- */

@media (max-width:650px) {

  .grid,
  .section-menu.open,
  .rashguards {
    grid-template-columns: 1fr;
  }

  .wide {
    grid-column: auto;
  }

  .stage {
    padding: 25px 16px 35px;
  }

  .brand {
    font-size: 11px;
  }

  .rashguard img {
    height: 330px;
  }

  .bottom-nav button {
    flex: 1;
  }

  .title {
    font-size: 39px;
  }
}
</style>
</head>


