<script>

const pageOrder = [
  "welcome",
  "gear",
  "culture",
  "disciplines",
  "coaches",
  "belts",
  "competition",
  "store",
  "faq",
  "first30"
];

let currentPage = 0;

const views =
  document.querySelectorAll(".view");

const menu =
  document.getElementById("sectionMenu");

const menuButton =
  document.getElementById("menuButton");

const sectionsButton =
  document.getElementById("sectionsButton");

const previousButton =
  document.getElementById("previousButton");

const nextButton =
  document.getElementById("nextButton");

const progressFill =
  document.getElementById("progressFill");


function showPage(pageName) {

  const pageIndex =
    pageOrder.indexOf(pageName);

  if (pageIndex === -1) {
    return;
  }

  currentPage = pageIndex;


  views.forEach(view => {

    view.classList.toggle(
      "active",
      view.dataset.page === pageName
    );

  });


  document
    .querySelectorAll("#sectionMenu button")
    .forEach(button => {

      button.classList.toggle(
        "current",
        button.dataset.view === pageName
      );

    });


  menu.classList.remove("open");

  menuButton.setAttribute(
    "aria-expanded",
    "false"
  );


  const progress =
    ((currentPage + 1) /
    pageOrder.length) * 100;


  progressFill.style.width =
    progress + "%";


  previousButton.disabled =
    currentPage === 0;


  previousButton.style.opacity =
    currentPage === 0
    ? "0.45"
    : "1";


  if (
    currentPage ===
    pageOrder.length - 1
  ) {

    nextButton.textContent =
      "Back to Welcome";

  } else {

    nextButton.textContent =
      "Next →";

  }


  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });

}


function toggleMenu() {

  const open =
    menu.classList.toggle("open");


  menuButton.setAttribute(
    "aria-expanded",
    String(open)
  );

}


menuButton.addEventListener(
  "click",
  toggleMenu
);


sectionsButton.addEventListener(
  "click",
  toggleMenu
);


document
  .querySelectorAll(
    "#sectionMenu button"
  )
  .forEach(button => {

    button.addEventListener(
      "click",
      () => {

        showPage(
          button.dataset.view
        );

      }
    );

  });


document
  .querySelectorAll("[data-next]")
  .forEach(button => {

    button.addEventListener(
      "click",
      () => {

        showPage(
          button.dataset.next
        );

      }
    );

  });


previousButton.addEventListener(
  "click",
  () => {

    if (currentPage > 0) {

      showPage(
        pageOrder[
          currentPage - 1
        ]
      );

    }

  }
);


nextButton.addEventListener(
  "click",
  () => {

    if (
      currentPage ===
      pageOrder.length - 1
    ) {

      showPage("welcome");

    } else {

      showPage(
        pageOrder[
          currentPage + 1
        ]
      );

    }

  }
);


/* CHECKLIST */

const checks =
  document.querySelectorAll(
    ".check input"
  );

const checkCount =
  document.getElementById(
    "checkCount"
  );


checks.forEach(check => {

  check.addEventListener(
    "change",
    () => {

      check
        .closest(".check")
        .classList.toggle(
          "complete",
          check.checked
        );


      const completed =
        [...checks]
          .filter(
            item => item.checked
          )
          .length;


      checkCount.textContent =
        completed +
        " of " +
        checks.length +
        " complete";

    }
  );

});


showPage("welcome");

</script>

